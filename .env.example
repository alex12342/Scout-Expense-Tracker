# Scout Expense Tracker — Environment Configuration
# Copy to .env (or set via your Unraid/docker-compose env) and fill in values.

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express API listens on INSIDE the container (Nginx fronts it on :80)
PORT=8080
NODE_ENV=production
# Log level: debug, info, warn, error
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
# Embedded Postgres runs inside the container (Supervisord-managed).
# This is the internal connection string the API uses.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/scout_expense_tracker
# Database name to create / sync on boot
DB_NAME=scout_expense_tracker

# ── Auth ─────────────────────────────────────────────────────────────────────
# Secret for signing JWTs. If left empty, a random secret is generated on first
# boot and persisted to /app/data/.jwt-secret so sessions survive restarts.
# JWT_SECRET=

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins, or "*" to allow all (fine behind a proxy).
CORS_ORIGIN=*

# ── First-run admin seed ─────────────────────────────────────────────────────
# Seeded on first boot only (when the users table is empty).
DEFAULT_ADMIN_USERNAME=admin
# Use a strong password. e.g.  Troop!Cub$123
DEFAULT_ADMIN_PASSWORD=ChangeMe123!
